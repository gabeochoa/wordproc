# Integration Test: Styled newsletter with colors, highlights, fonts, spacing
# Exercises: text colors, highlight colors, font changes, line spacing,
#            indentation, superscript/subscript, drop cap, alignment

# --- Banner / Title ---
key CTRL+E
menu_open Format
menu_select "Title"
wait 1
type "THE WEEKLY DIGEST"
key ENTER

menu_open Format
menu_select "Normal"
wait 1
key CTRL+E

# Color the subtitle
menu_open Format
menu_select "Text: Blue"
wait 1
type "Volume 14, Issue 7 - February 2026"
key ENTER

# Reset color
menu_open Format
menu_select "Text: Black"
wait 1
key CTRL+L
key ENTER

# --- Lead story with drop cap ---
menu_open Format
menu_select "Heading 2"
wait 1
type "Lead Story: Breakthrough in Quantum Computing"
key ENTER

menu_open Format
menu_select "Normal"
wait 1

# Enable drop cap for the first paragraph
menu_open Format
menu_select "Drop Cap"
wait 1

type "Researchers at MIT have announced a major milestone in quantum error correction, achieving a 99.9% fidelity rate in a 48-qubit system. This development brings practical quantum computing significantly closer to reality."
key ENTER
key ENTER

# --- Highlighted callout box ---
menu_open Format
menu_select "Highlight: Yellow"
wait 1
key CTRL+B
type "BREAKING: "
key CTRL+B
type "The team will present their findings at the International Quantum Summit in Geneva next month."
menu_open Format
menu_select "Highlight: None"
wait 1
key ENTER
key ENTER

# --- Second article with different font ---
menu_open Format
menu_select "Heading 2"
wait 1
type "Technology: AI in Healthcare"
key ENTER

menu_open Format
menu_select "Normal"
wait 1

# Switch to Gaegu font for a casual section
menu_open Format
menu_select "Font: Gaegu"
wait 1

type "New studies show AI diagnostic tools are now matching specialist-level accuracy in radiology. The FDA approved three new AI-assisted imaging platforms this quarter."
key ENTER

# Back to Garamond
menu_open Format
menu_select "Font: Garamond"
wait 1
key ENTER

# --- Science corner with super/subscript ---
menu_open Format
menu_select "Heading 2"
wait 1
type "Science Corner"
key ENTER

menu_open Format
menu_select "Normal"
wait 1

type "Water molecule: H"
key CTRL+SHIFT+-
type "2"
key CTRL+SHIFT+-
type "O"
key ENTER

type "Einstein's famous equation: E = mc"
key CTRL+SHIFT+=
type "2"
key CTRL+SHIFT+=
key ENTER
key ENTER

# --- Closing with increased line spacing ---
menu_open Format
menu_select "Double Spacing"
wait 1

type "Thank you for reading The Weekly Digest. For subscriptions, contact editor@weeklydigest.com."
key ENTER
type "Next issue: February 19, 2026"

wait 2

# === Final document validation ===
validate is_dirty=true

# Content checks
validate text_contains_THE WEEKLY DIGEST=true
validate text_contains_Volume 14, Issue 7=true
validate text_contains_Quantum Computing=true
validate text_contains_99.9% fidelity=true
validate text_contains_BREAKING:=true
validate text_contains_Geneva=true
validate text_contains_AI in Healthcare=true
validate text_contains_FDA approved=true
validate text_contains_Science Corner=true
validate text_contains_Einstein=true
validate text_contains_editor@weeklydigest.com=true
validate text_contains_February 19, 2026=true

# Formatting at end of doc
validate bold=false
validate italic=false
validate underline=false

# Drop cap should exist on the lead paragraph
# (We set it earlier; can't move caret there easily, but content validates it was created)

screenshot e2e_styled_newsletter

