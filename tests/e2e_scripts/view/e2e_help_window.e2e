# Test: Help window (F1)
# Validates F1 opens help/keyboard shortcuts window

# Press F1 to open help
key F1
wait 2

# Validate help window is visible
validate help_window_visible=true

# Validate help window is showing (content check proxied by visibility)
validate help_has_Keyboard Shortcuts=true
validate help_has_Ctrl+B=true
validate help_has_Bold=true
validate help_has_Ctrl+S=true
validate help_has_Save=true

# Close help window
key ESCAPE
wait 2
validate help_window_visible=false

# Reopen via Help menu
menu_open Help
wait 2
menu_select Keyboard Shortcuts...
wait 2
validate help_window_visible=true

key ESCAPE
wait 2

screenshot e2e_help_window

