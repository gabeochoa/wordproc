# Test: Bold text formatting (Ctrl+B)
# Validates that bold formatting can be toggled

# Type some text
type "Bold Text Test"
wait_frames 12

# Select all and apply bold
select_all
wait_frames 12
key CTRL+B
wait_frames 12

# Validate bold is enabled
validate bold=true

# Toggle bold off
key CTRL+B
wait_frames 12
validate bold=false

screenshot 02_bold_formatting

