# Test: Verify File menu dropdown opens and shows all items
# This test clicks the File button and validates the dropdown content

# Wait for window to render
wait 5

# Verify File button is visible first
expect_text "File"

# Click on File button using text-based click (no hardcoded coords)
click_text "File"

# Wait for click to be processed and menu to open
wait 2

# Take screenshot to verify dropdown is open
screenshot file_menu_dropdown

# Verify File menu items are visible (they should be registered by MenuUISystem)
expect_text "New"
expect_text "Open..."
expect_text "Save"
expect_text "Exit"

