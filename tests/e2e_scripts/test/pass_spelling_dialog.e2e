# Test: Tools > Spelling... dialog, Change to first suggestion
# "wrold" is misspelled; the engine's first suggestion for it is "hold"
# (edit-distance ranking, pinned by unit test). Clicking that suggestion
# then Change replaces the typo: "The wrold fox" -> "The hold fox".

type "The wrold fox"
wait_frames 12

menu_open Tools
wait_frames 12
menu_select "Spelling..."
wait_frames 12

validate dialog_open=Spelling

# Click the first suggestion ("hold"), then Change
click_ui spell_suggestion_hold
wait_frames 12
click_ui spell_change
wait_frames 12

validate text=The hold fox

click_ui spell_close
wait_frames 12
