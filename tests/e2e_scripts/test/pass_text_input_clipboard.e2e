# Test: Text input clipboard operations (Copy/Paste) in Find dialog

type "Document text here"
wait_frames 6

key CTRL+F
wait_frames 30

focus_ui find_input
wait_frames 12
type "copy this"
wait_frames 12

expect_input_text find_input "copy this"
screenshot text_input_clipboard_01_typed

action TextSelectAll
wait_frames 6

screenshot text_input_clipboard_02_selected

action TextCopy
wait_frames 6

action WidgetRight
wait_frames 6

type " extra"
wait_frames 12
expect_input_text find_input "copy this extra"
screenshot text_input_clipboard_03_appended

action TextSelectAll
wait_frames 6
action TextPaste
wait_frames 6

expect_input_text find_input "copy this"
screenshot text_input_clipboard_04_paste_replaced

escape
wait_frames 6
