# Test: Verify Font Size dropdown on formatting toolbar opens and shows items
# Validates that clicking the Font Size dropdown shows size options

# Wait for window to render
wait_frames 30

# Verify the current font size is visible
expect_text "10"

# Click the Font Size dropdown button by debug name (not
# click_text "10": the Standard toolbar's Zoom dropdown label
# "100%" also contains "10" and is created first, so a text click
# would open the Zoom dropdown instead).
click_ui dropdown_fontsize

# Wait for dropdown to open
wait_frames 18

# Take screenshot to verify dropdown is open and visible
screenshot toolbar_fontsize_dropdown

# Verify font size items are visible
expect_text "12"
expect_text "14"
expect_text "18"
expect_text "24"

# Click elsewhere to close the dropdown
mouse_down 500 300
wait_frames 2
mouse_up
wait_frames 12
