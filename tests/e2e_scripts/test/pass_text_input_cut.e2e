# Test: Text input Cut in Find dialog

type "Some document content"
wait_frames 6

key CTRL+F
wait_frames 30

focus_ui find_input
wait_frames 12
type "cut me out"
wait_frames 12
expect_input_text find_input "cut me out"

action TextSelectAll
wait_frames 6

action TextCut
wait_frames 6

expect_input_text find_input ""
screenshot text_input_cut_01_empty_after_cut

action TextPaste
wait_frames 6

expect_input_text find_input "cut me out"
screenshot text_input_cut_02_paste_after_cut

escape
wait_frames 6
