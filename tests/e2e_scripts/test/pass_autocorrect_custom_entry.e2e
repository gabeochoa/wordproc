# Test: AutoCorrect dialog Add appends a custom entry that autocorrects
# Open Tools > AutoCorrect..., type a Replace/With pair into the fields,
# Add it, close with OK, then type the trigger word: "wrold " corrects
# to "World " ("wrold" is not built-in; the sentence-start capital applies,
# as in pass_autocorrect_replace.e2e where "teh quick" -> "The quick").

menu_open Tools
wait_frames 12
menu_select "AutoCorrect..."
wait_frames 12

validate dialog_open=AutoCorrect

focus_ui autocorrect_replace_input
wait_frames 12
type "wrold"
wait_frames 12
expect_input_text autocorrect_replace_input "wrold"

focus_ui autocorrect_with_input
wait_frames 12
type "world"
wait_frames 12
expect_input_text autocorrect_with_input "world"

click_ui autocorrect_add
wait_frames 12

click_ui autocorrect_ok
wait_frames 12

type "wrold x"
wait_frames 12

validate text=World x
