# Test: Switch between menus - open File, close, open Edit
# Validates that menus can be opened and closed independently

# Wait for window to render
wait 5

# Open File menu
click 28 34
wait 2

# Verify File menu is open
expect_text "New"
expect_text "Save"

# Take screenshot with File menu open
screenshot menu_switch_file_open

# Close File menu by clicking elsewhere
click 500 300
wait 2

# Open Edit menu
click 57 34
wait 2

# Verify Edit menu items are visible (not File menu items)
expect_text "Undo"
expect_text "Cut"
expect_text "Paste"

# Take screenshot with Edit menu open
screenshot menu_switch_edit_open

# Close Edit menu
click 500 300
wait 2

# Verify all menus are closed - toolbar text should be visible
expect_text "Normal"
expect_text "File"
expect_text "Edit"
