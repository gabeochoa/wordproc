# Test: Format > Font... pending state sync (regression).
# Clicking a list/dropdown updates the field text AND the Preview
# before OK -- one pending state, not a stale field + stale preview.
# RED-ON-REVERT: without the fields, "Font field: Arial" /
# "Preview font: Arial, size 18" are never registered, so the
# expect_text lines fail. Cancel proves the pending picks were
# never applied (underline stays false).

type "Hello Font"
wait_frames 12
select_all
wait_frames 12

menu_open Format
wait_frames 12
menu_select "Font..."
wait_frames 12

validate dialog_open=Font
expect_text "Font style:"
expect_text "AaBbYyZz 123"

screenshot font_dialog_pending

click_ui font_item_Arial
wait_frames 12
click_ui font_size_18
wait_frames 12

expect_text "Font field: Arial"
expect_text "Size field: 18"
expect_text "Preview font: Arial, size 18"

click_ui font_underline_dropdown
wait_frames 12
click_ui font_underline_Single
wait_frames 12
expect_text "Underline style: Single"

click_ui font_color_dropdown
wait_frames 12
click_ui font_color_option_Red
wait_frames 12
expect_text "Font color: Red"

click_ui font_cancel
wait_frames 12

validate dialog_open=false
validate underline=false
