# Test: Format > Paragraph... tabbed dialog sets indent + spacing +
# line spacing + alignment + Special/By in one undo step.
# Tab 1 ("Indents and Spacing") carries the Alignment dropdown,
# Left/Right indents, Special (None / First line / Hanging) +
# By amount driving firstLineIndent, Before/After spacing, the
# Line spacing dropdown, and a Tabs... button (no Default tab
# stops field: per-paragraph tab stops do not exist).
# Dialog OK writes the same per-paragraph fields the menu
# increments and the ruler drag use (indents in 72-dpi units,
# spaceBefore/spaceAfter in points, line-spacing multiplier):
# Left 0.5in -> left_indent 36, After 12pt -> space_after 12,
# Line spacing dropdown Double -> line_spacing 2.0, Special
# Hanging + By 0.25 -> first_line_indent -18, Alignment Centered
# -> alignment=center. One Ctrl+Z restores all of them (single
# undo step). The post-OK screenshot shows the ruler markers
# moved with the new left indent.
#
# Regression: the pre-tab dialog had a "First line (inches):"
# field and a Default-tab-stops field, no Alignment dropdown,
# and its OK rebuilt the format from scratch (wiping borders).

type "Hello Paragraph"
wait_frames 12

menu_open Format
wait_frames 12
menu_select "Paragraph..."
wait_frames 12

validate dialog_open=Paragraph
expect_text "Indents and Spacing"
expect_text "Line and Page Breaks"
expect_text "Alignment:"
expect_text "Special:"
expect_text "By:"
expect_text "Indentation:"
expect_text "Spacing:"
expect_text "Line spacing:"
expect_text "Tabs..."
expect_text "Tab stops are document-wide."
expect_input_text paragraph_left_input "0"
expect_input_text paragraph_after_input "0"
expect_input_text paragraph_by_input "0.5"

screenshot paragraph_dialog

focus_ui paragraph_left_input
wait_frames 12
key END
key BACKSPACE
key BACKSPACE
key BACKSPACE
type "0.5"
wait_frames 12
expect_input_text paragraph_left_input "0.5"

focus_ui paragraph_after_input
wait_frames 12
key END
key BACKSPACE
key BACKSPACE
key BACKSPACE
type "12"
wait_frames 12
expect_input_text paragraph_after_input "12"

click_ui paragraph_special_dropdown
wait_frames 12
click_ui paragraph_special_hanging
wait_frames 12

focus_ui paragraph_by_input
wait_frames 12
key END
key BACKSPACE
key BACKSPACE
key BACKSPACE
type "0.25"
wait_frames 12
expect_input_text paragraph_by_input "0.25"

click_ui paragraph_alignment_dropdown
wait_frames 12
click_ui paragraph_alignment_centered
wait_frames 12

click_ui paragraph_linespacing_dropdown
wait_frames 12
click_ui paragraph_linespacing_double
wait_frames 12

click_ui paragraph_ok
wait_frames 12

validate dialog_open=false
validate text=Hello Paragraph
validate left_indent=36
validate first_line_indent=-18
validate right_indent=0
validate space_before=0
validate space_after=12
validate line_spacing=2.000000
validate alignment=center

screenshot paragraph_after

# One undo step restores the indent, spacing, line spacing,
# alignment, and Special/By.
key CTRL+Z
wait_frames 12
validate left_indent=0
validate first_line_indent=0
validate space_after=0
validate line_spacing=1.000000
validate alignment=left
