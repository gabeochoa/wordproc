# Test: Word navigation with UTF-8 support
# Validates that Ctrl+Left/Right work correctly with emoji and CJK

# Type text with emoji
type "hello 👍 world 😀 test"
wait 2

# Move to end
key END
wait 1

# Navigate left word-by-word (should handle emoji correctly)
key CTRL+LEFT
wait 1
key CTRL+LEFT
wait 1
key CTRL+LEFT
wait 1

# Type CJK text
type " 你好 世界"
wait 2

# Navigate through CJK text
key CTRL+LEFT
wait 1
key CTRL+LEFT
wait 1

screenshot e2e_word_navigation_utf8

# Validate we didn't crash
validate line_count=1

