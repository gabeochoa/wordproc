# Test: Verify View menu dropdown opens and shows items
# Clicks the View button and validates dropdown content

# Wait for window to render
wait_frames 30

# Verify View button is visible
expect_text "View"

# Click on View button using text-based click
click_text "View"

# Wait for menu to open
wait_frames 12

# Take screenshot
screenshot view_menu_dropdown

# Verify View menu items are visible
expect_text "Zoom In"
expect_text "Zoom Out"
expect_text "Focus Mode"
expect_text "Dark Mode"

# Close menu
click 500 300
wait_frames 12
