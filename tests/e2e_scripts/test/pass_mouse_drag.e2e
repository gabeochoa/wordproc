# Test: Mouse drag selection
# Validates that mouse drag creates text selection

# Type some text first
type "Drag to select me"
wait 2
validate text=Drag to select me

# Screenshot before any mouse interaction
screenshot pass_mouse_drag_before_drag

# Move mouse to start of text area
mouse_move 100 100
wait 2

# Screenshot showing mouse positioned
screenshot pass_mouse_drag_mouse_positioned
