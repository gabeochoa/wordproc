# Test: Toolbar button hover interaction after cursor/hover styling updates
# Validates toolbar buttons still function with with_cursor(Pointer) and hover bg

# Wait for window to render
wait_frames 30

# Verify toolbar formatting buttons are visible
expect_text "B"
expect_text "I"
expect_text "U"

# Verify dropdowns are visible
expect_text "Normal"
expect_text "Times New Roman"
expect_text "10"

# Type some text
type "Toolbar hover test"
wait_frames 12

# Select all text
select_all
wait_frames 6

# Apply bold via toolbar shortcut
key CTRL+B
wait_frames 6
validate bold=true

# Apply italic
key CTRL+I
wait_frames 6
validate italic=true

# Take screenshot showing active formatting buttons
screenshot toolbar_hover_active_buttons
