# Test: Format > Borders and Shading... boxes + shades one paragraph.
# Dialog Setting Box + Yellow shading swatch applies a 4-edge Single
# border (border_edges 15) and shading index 1 to the caret paragraph
# only; the neighbor paragraph stays plain (0 / 0). One Ctrl+Z
# restores the paragraph. The post-OK screenshot shows the boxed +
# shaded paragraph above the plain neighbor.
#
# Note the caret moves, not the mouse: after typing both paragraphs
# the caret is on row 1, key UP returns to the boxed row 0.

type "Boxed paragraph"
key ENTER
type "Plain neighbor"
wait_frames 12

key UP
wait_frames 12
key HOME
wait_frames 12

menu_open Format
wait_frames 12
menu_select "Borders and Shading..."
wait_frames 12

validate dialog_open=BordersShading
expect_text "Setting:"
expect_text "Edges:"
expect_text "Style:"
expect_text "Shading:"
expect_text "Shading: None"

click_ui borders_setting_box
wait_frames 12
click_ui borders_shading_yellow
wait_frames 12
expect_text "Shading: Yellow"

click_ui borders_ok
wait_frames 12

validate dialog_open=false
validate border_edges=15
validate border_style=1
validate shading_index=1

screenshot borders_shading

# The neighbor paragraph is untouched.
key DOWN
wait_frames 12
validate border_edges=0
validate border_style=0
validate shading_index=0

# One undo step restores the boxed paragraph.
key UP
wait_frames 12
key CTRL+Z
wait_frames 12
validate border_edges=0
validate border_style=0
validate shading_index=0
