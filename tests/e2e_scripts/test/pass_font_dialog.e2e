# Test: Format > Font... dialog applies size + Bold to the
# selection (per-range span, same as the toolbar).
# Open the dialog, screenshot it, pick Bold + size 18, OK, and
# assert the applied style. The dialog is the FIRST Format item.

type "Hello Font"
wait_frames 12
select_all
wait_frames 12

menu_open Format
wait_frames 12
menu_select "Font..."
wait_frames 12

validate dialog_open=Font
expect_text "Font style:"
expect_text "AaBbYyZz 123"
expect_text "Times New Roman"

screenshot font_dialog

click_ui font_style_Bold
wait_frames 12
click_ui font_size_18
wait_frames 12
click_ui font_ok
wait_frames 12

validate dialog_open=false
validate bold=true
validate font_size=18
