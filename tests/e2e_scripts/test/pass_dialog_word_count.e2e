# Test: Word Count dialog shows correct counts for a known document
# "One two three." = 3 words, 14 chars (excludes newline), 1 paragraph,
# 1 sentence. The dialog renders the same TextStats these validates read,
# so opening it on this document proves the counts it displays.

type "One two three."
wait_frames 12

# Open Word Count dialog via Tools menu
menu_open Tools
wait_frames 12
menu_select "Word Count..."
wait_frames 12

# Validate dialog is open and the counts it shows are correct
validate dialog_open=WordCount
validate word_count=3
validate char_count=14
validate paragraph_count=1
validate sentence_count=1

# Take screenshot showing the dialog
screenshot dialog_word_count_counts
