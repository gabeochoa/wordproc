# Test: Verify Style dropdown on formatting toolbar opens and shows items
# Validates that clicking the Style dropdown shows all paragraph style options

# Wait for window to render
wait_frames 30

# Verify the current style label is visible
expect_text "Normal"

# Click the Style dropdown button using text-based click
click_text "Normal"

# Wait for dropdown to open
wait_frames 18

# Take screenshot to verify dropdown is open and visible (not behind toolbar)
screenshot toolbar_style_dropdown

# Verify dropdown items are visible
expect_text "Heading 1"
expect_text "Heading 2"
expect_text "Title"

# Click elsewhere to close the dropdown
click 500 300
wait_frames 12

# Verify dropdown closed (style didn't change)
expect_text "Normal"
