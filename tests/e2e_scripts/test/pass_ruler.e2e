# Test: Ruler (Word 95 style)
# Validates ruler visibility, marker drag -> paragraph indents
# (one undo step per drag), and View > Ruler toggling reclaims space.
# Coordinates are the 1280x720 layout at ui_scale 1.2 (scaled chrome:
# 31 title + 28 menu + 34 toolbar + 34 formatting + 24 ruler + 4 border):
# text area y=153, ruler band y=129..153, origin x=11.6
# (text area x=3.6 + 8px padding), right marker x=1268.

type "Ruler drag test"
wait_frames 12

validate ruler_visible=true
validate text_area_y=153
validate left_indent=0

# Drag the left-indent marker (bottom half of ruler) +72px right.
drag_to 12 148 84 148
wait_frames 6
validate left_indent=72

# The whole drag is one undo step.
key CTRL+Z
wait_frames 6
validate left_indent=0

# Drag the first-line marker (top half of ruler) +36px right.
drag_to 12 135 48 135
wait_frames 6
validate first_line_indent=36

# Drag the right-indent marker (bottom half) 72px left.
drag_to 1268 148 1196 148
wait_frames 6
validate right_indent=72

# View > Ruler off: the text area reclaims the 24px band.
menu_open View
menu_select "Ruler"
wait_frames 6
validate ruler_visible=false
validate text_area_y=129

# View > Ruler on: the band comes back.
menu_open View
menu_select "Ruler"
wait_frames 6
validate ruler_visible=true
validate text_area_y=153

screenshot ruler
