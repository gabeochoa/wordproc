# Test: Drop-cap glyph uses the effective style at offset 0
# (Batch 13). Bold the first letter, then apply a 3-line drop
# cap: the dropped glyph draws bold (double-struck), while the
# rest of the line keeps the whole-line draw. The runner has
# no glyph-style property, so the proof is the screenshot
# (pixel ink comparison against the unstyled drop cap in the
# batch report).

type "Hello world, this is a paragraph with a drop cap."
wait_frames 12

# Bold just the first letter: select "H", Ctrl+B, collapse.
key HOME
wait_frames 6
key SHIFT+RIGHT
wait_frames 6
validate selected_text=H
key CTRL+B
wait_frames 12
validate bold=true
key RIGHT
wait_frames 6
validate bold=false

# Back to the paragraph start, then Format > Drop Cap.
key HOME
wait_frames 6

menu_open Format
wait_frames 12
menu_select "Drop Cap"
wait_frames 12

validate dialog_open=DropCap

click_ui dropcap_dropped
wait_frames 12
click_ui dropcap_lines_plus
wait_frames 12
expect_text "Lines: 3"

click_ui dropcap_ok
wait_frames 12

validate dialog_open=false
validate drop_cap=true
validate drop_cap_lines=3

screenshot dropcap_styled_first_letter
