# Test: Debug overlay visibility test
# This test runs long enough to capture the debug overlay

# Wait enough time to see the overlay (debug overlay should appear quickly)
wait 5

# Expect some text to be on screen
expect_text "File"

# Wait a bit more
wait 5

# Another check
expect_text "Edit"

# Final wait to ensure overlay is visible
wait 5

# Take a screenshot (overlay should be visible in this)
screenshot debug_overlay_visible



