# Test: Spelling dialog Add puts the word in the user dictionary
# "wrold" becomes a known word, so no errors remain and the
# document text is unchanged.

type "The wrold fox"
wait_frames 12

menu_open Tools
wait_frames 12
menu_select "Spelling..."
wait_frames 12

validate dialog_open=Spelling

click_ui spell_add
wait_frames 12

validate spell_error_count=0
validate text=The wrold fox

click_ui spell_close
wait_frames 12
