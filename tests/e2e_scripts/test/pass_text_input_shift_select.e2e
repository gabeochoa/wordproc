# Test: Text input Shift+Arrow selection in Find dialog
#
# Real keys, not `action TextSelectLeft`: the `action` command sets
# last_action without holding Shift, and text_input decides
# selection-vs-collapse from the raw Shift state, so `action
# TextSelectLeft` collapses instead of extending (a harness
# limitation, not the app). `key SHIFT+LEFT` is the real surface:
# it exercises the InputCollector chord and the shift_held path.

type "Hello World"
wait_frames 6

key CTRL+F
wait_frames 30

focus_ui find_input
wait_frames 12
type "search me"
wait_frames 12
expect_input_text find_input "search me"
screenshot text_input_shift_select_01_typed

key LEFT
wait_frames 3
key LEFT
wait_frames 3
key LEFT
wait_frames 3

key SHIFT+LEFT
wait_frames 6

expect_input_selection find_input 5 6
screenshot text_input_shift_select_02_one_char

key SHIFT+LEFT
wait_frames 3
key SHIFT+LEFT
wait_frames 3
expect_input_selection find_input 3 6
screenshot text_input_shift_select_03_extended

escape
wait_frames 6
