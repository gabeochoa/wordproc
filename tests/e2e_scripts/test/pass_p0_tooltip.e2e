# P0-7: toolbar tooltip appears only after ~0.5s of steady hover, in
# Win95 style (pale yellow #FFFFE1, 1px black border, 4px/2px padding).
# Save button center is (79, 76) at 1280x720 / ui_scale 1.2; the tooltip
# lands just below it at about y=92.
mouse_move 79 76
wait_frames 6
screenshot p0_tooltip_before_delay
wait_frames 900
screenshot p0_tooltip_after_delay
