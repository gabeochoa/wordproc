type "Editor selection"
key CTRL+A
key CTRL+C
key CTRL+F
wait_frames 20
focus_ui find_input
wait_frames 6
action TextSelectAll
action TextPaste
wait_frames 6
expect_input_text find_input "Editor selection"
action TextSelectAll
type "Dialog selection"
action TextSelectAll
action TextCopy
wait_frames 6
escape
wait_frames 6
key CTRL+A
key CTRL+V
wait_frames 6
validate text=Dialog selection
screenshot shared_clipboard
