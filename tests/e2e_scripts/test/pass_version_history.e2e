# Test: Version History (Docs history, Win95 dress)
# Save snapshots the document; typing more, then opening File >
# Version History... and restoring the newest snapshot brings back
# the saved text through the command layer (one undo, marks dirty).

type "original text"
wait_frames 12

menu_open File
wait_frames 12
menu_select "Save"
wait_frames 12
validate is_dirty=false

type " plus more"
wait_frames 12
validate text=original text plus more

menu_open File
wait_frames 12
menu_select "Version History..."
wait_frames 12
validate dialog_open=VersionHistory
expect_text "words"

screenshot version_history

click_ui version_item_0
wait_frames 12
click_ui version_restore
wait_frames 12
validate text=original text
validate is_dirty=true

click_ui version_history_close
wait_frames 12
