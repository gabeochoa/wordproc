# Test: Verify typed text is visible on screen
# Validates that document content can be checked with expect_text

# Screenshot empty document
wait 3
screenshot pass_expect_text_document_empty

# Type some text
type "Hello World"
wait 3

# Verify the text appears on screen
expect_text "Hello World"

# Screenshot showing first line of text rendered
screenshot pass_expect_text_document_first_line

# Type more text on a new line
key ENTER
type "This is a test"
wait 3

# Both lines should be visible
expect_text "Hello World"
expect_text "This is a test"

# Screenshot showing both lines rendered
screenshot pass_expect_text_document_two_lines
