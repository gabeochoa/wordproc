# Test: Programmatic window resize via metal_set_window_size
# Validates resize command works after implementing the backend function

# Wait for window to render
wait 5

# Verify initial state
validate menu_bar_fits=true
validate toolbar_fits=true

# Resize to several sizes and verify UI adapts

# Large window
resize 1920 1080
wait 2
validate menu_bar_fits=true
validate toolbar_fits=true
validate formatting_bar_fits=true
validate editing_area_gt_500=true
screenshot resize_1920x1080

# Medium window
resize 1024 768
wait 2
validate menu_bar_fits=true
validate toolbar_fits=true
validate menu_header_onscreen_File=true
validate menu_header_onscreen_Help=true
screenshot resize_1024x768

# Small window
resize 640 480
wait 2
validate menu_header_onscreen_File=true
validate menu_header_onscreen_Help=true
screenshot resize_640x480

# Very narrow
resize 500 400
wait 2
validate menu_header_onscreen_File=true
screenshot resize_500x400

# Restore to default
resize 1280 720
wait 2
validate menu_bar_fits=true
validate toolbar_fits=true
