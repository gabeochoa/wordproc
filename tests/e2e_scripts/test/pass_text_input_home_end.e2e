# Test: Text input Home/End keys in Find dialog

type "test text"
wait_frames 6

key CTRL+F
wait_frames 30

focus_ui find_input
wait_frames 12
type "beginning and end"
wait_frames 12
expect_input_text find_input "beginning and end"

action TextHome
wait_frames 6

type "AT_START_"
wait_frames 12
expect_input_text find_input "AT_START_beginning and end"
screenshot text_input_home_end_01_insert_at_home

action TextEnd
wait_frames 6

type "_AT_END"
wait_frames 12
expect_input_text find_input "AT_START_beginning and end_AT_END"
screenshot text_input_home_end_02_insert_at_end

escape
wait_frames 6
