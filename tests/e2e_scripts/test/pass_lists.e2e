# Test: Bulleted and numbered lists (Ctrl+Shift+8/7)
# Validates list toggling

type "List Item Test"
wait_frames 12

# Default should be no list
validate list_type=none

# Toggle bulleted list
key CTRL+SHIFT+8
wait_frames 12
validate list_type=bulleted

# Toggle off
key CTRL+SHIFT+8
wait_frames 12
validate list_type=none

# Toggle numbered list
key CTRL+SHIFT+7
wait_frames 12
validate list_type=numbered

screenshot 08_lists

