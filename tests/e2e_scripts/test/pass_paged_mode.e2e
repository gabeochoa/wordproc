# Test: Page Layout framing
# Validates View > Page Layout switches the page mode (white Letter
# page centered on the gray workspace, text inside the margins —
# verified visually in the headless screenshot) and back to Normal.

type "Paged mode check."
wait_frames 12
validate page_mode=pageless

menu_open View
menu_select "Page Layout"
wait_frames 12
validate page_mode=paged
# ONE scale: page width must be 8.5 * ruler ppi (fit ~0.59 -> ppi ~42,
# page ~361px). Pre-fix the ruler used a fixed 72 px/in against a
# ~361px page, so these two props disagreed.
validate ruler_ppi=42
validate page_display_width=361
validate page_width_inches_x10=85
# ONE scale for text too: the 16px base renders at 9px with a 13px
# line height at the ~0.58 paged fit (was 16/20: full-size text
# overflowing the 6.5" text width). Pre-fix these props are unknown.
validate text_font_size=9
validate text_line_height=13
# Text boundaries are off by default (Word 95 Tools > Options >
# View): no margin guides on the page. Pre-fix the guides were
# always drawn and this prop was unknown.
validate text_boundaries=false
# Click hit-testing uses the same scaled font: x=550 is 40px into
# "Paged mode check." at 9px, landing on col 9 (at the old 16px
# font the same click landed near col 5).
mouse_down 550 220
wait_frames 2
mouse_up
wait_frames 6
validate caret_col=9
validate caret_row=0
# Mode switch is transient status-bar text, not a floating toast.
validate status_text=Page Layout
screenshot paged_mode

menu_open View
menu_select Normal
wait_frames 12
validate page_mode=pageless
validate normal_view=true
# Pageless displayScale == zoomLevel: font metrics back to 16/20,
# byte-identical to before the paged scaling fix.
validate text_font_size=16
validate text_line_height=20
validate status_text=Normal view
