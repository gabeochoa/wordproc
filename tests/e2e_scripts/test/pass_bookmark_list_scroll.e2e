# Test: Bookmark list dialog with Overflow::Auto
# Validates bookmark creation and the bookmark list dialog

# Type text on multiple lines
type "Chapter One"
key ENTER
type "Chapter Two"
key ENTER
type "Chapter Three"
wait_frames 12

# Go to line 1 and create a bookmark
key CTRL+HOME
wait_frames 6

menu_open Insert
wait_frames 12
menu_select "Bookmark..."
wait_frames 12

validate has_bookmark=true
validate bookmark_count=1

screenshot bookmark_list_created

# Verify Edit menu has Go To Bookmark
menu_open Edit
wait_frames 12
validate menu_open=Edit

screenshot bookmark_list_menu
