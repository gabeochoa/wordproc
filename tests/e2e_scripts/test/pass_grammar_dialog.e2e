# Test: Tools > Grammar... dialog is a real checker mirroring the
# Spelling dialog: one issue at a time (In context / Issue /
# Suggestion), Ignore Once, Ignore All (session-ignore rule+phrase),
# Change (applies the suggestion), Close.
#
# "The the cat sat. A  B" yields two issues: Repeated word, then a
# double space. Ignore All on the repeated word session-ignores
# REPEATED_WORD + "The the" (text unchanged); Change on the double
# space collapses it to "A B". The pinned single-issue flow
# ("The the cat sat." Change -> "The cat sat.") is covered by the
# unit test; this E2E proves the dialog wiring end to end.

type "The the cat sat. A  B"
wait_frames 12

menu_open Tools
wait_frames 12
menu_select "Grammar..."
wait_frames 12

validate dialog_open=Grammar
validate grammar_error_count=2
expect_text "Repeated word"
expect_text "The the cat sat."

screenshot grammar_dialog

# Ignore All: the repeated word is session-ignored; the next issue
# (double space) becomes current and the text is untouched.
click_ui grammar_ignore_all
wait_frames 12
validate grammar_error_count=1
validate text=The the cat sat. A  B
expect_text "Multiple consecutive spaces"
expect_text "A  B"

# Change: apply the " " suggestion through the command layer.
click_ui grammar_change
wait_frames 12
validate grammar_error_count=0
validate text=The the cat sat. A B
expect_text "Grammar check complete."

click_ui grammar_close
wait_frames 12
validate dialog_open=false
validate text=The the cat sat. A B
