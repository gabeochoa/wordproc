# Test: File menu validation
# Validates File menu opens and contains expected items

# Open File menu
menu_open File
wait 1

# Validate menu is open
validate menu_open=File

# Validate expected menu items exist
validate menu_item_New=true
validate menu_item_Open...=true
validate menu_item_Save=true
validate menu_item_Save As...=true
validate menu_item_Page Setup...=true
validate menu_item_Exit=true

screenshot e2e_menu_file

