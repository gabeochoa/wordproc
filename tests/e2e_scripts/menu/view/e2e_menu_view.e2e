# Test: View menu validation
# Validates View menu opens and contains expected items

# Open View menu
menu_open View
wait 1

# Validate menu is open
validate menu_open=View

# Validate expected menu items exist
validate menu_item_Pageless Mode=true
validate menu_item_Paged Mode=true
validate menu_item_Show Line Numbers=true
validate menu_item_Show Outline=true
validate menu_item_Focus Mode=true
validate menu_item_Dark Mode=true
validate menu_item_Zoom In=true

screenshot e2e_menu_view

