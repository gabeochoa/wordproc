# Test: Format menu validation
# Validates Format menu opens and contains expected items

# Open Format menu
menu_open Format
wait 1

# Validate menu is open
validate menu_open=Format

# Validate expected menu items exist
validate menu_item_Bold=true
validate menu_item_Italic=true
validate menu_item_Underline=true
validate menu_item_Strikethrough=true
validate menu_item_Font: Gaegu=true
validate menu_item_Font: Garamond=true
validate menu_item_Bulleted List=true
validate menu_item_Text Color...=true
validate menu_item_Highlight Color...=true

screenshot e2e_menu_format

