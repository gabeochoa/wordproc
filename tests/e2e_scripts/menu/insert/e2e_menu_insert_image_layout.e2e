# Test: Insert > Image Layout...
# Validates menu item exists and can be selected (no-op handler)

# First insert an image
menu_open Insert
menu_select "Image..."
wait 1
validate has_image=true

# Try Image Layout (currently a no-op)
menu_open Insert
menu_select "Image Layout..."
wait 1

# Image should still be present
validate image_count=1

screenshot e2e_menu_insert_image_layout
