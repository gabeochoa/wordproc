# Test: Edit menu validation
# Validates Edit menu opens and contains expected items

# Open Edit menu
menu_open Edit
wait 1

# Validate menu is open
validate menu_open=Edit

# Validate expected menu items exist
validate menu_item_Undo=true
validate menu_item_Redo=true
validate menu_item_Cut=true
validate menu_item_Copy=true
validate menu_item_Paste=true
validate menu_item_Select All=true
validate menu_item_Find...=true
validate menu_item_Replace...=true

screenshot e2e_menu_edit

