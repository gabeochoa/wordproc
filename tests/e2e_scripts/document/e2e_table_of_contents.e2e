# Test: Table of Contents is a real generated block, not headings.
# Insert > Table of Contents inserts a marked block at the caret
# (one line per Title/Heading 1-3 paragraph: indent, dot leader,
# estimated page number); inserting again replaces it (no
# duplication); Insert > Update Table of Contents regenerates it
# after a heading is added; the right-click context menu offers
# the same Update while a TOC exists.

type "First Heading"
key CTRL+ALT+1
key ENTER
type "Body text"
key ENTER
type "Second Heading"
key CTRL+ALT+2
key ENTER
type "More body"
key ENTER
type "Third Heading"
key CTRL+ALT+2
wait_frames 12

# Insert the TOC at the top. (key CTRL+HOME does not move the
# caret — pre-existing harness quirk, see pass_goto_dialog.e2e —
# so walk up with UP, then HOME to column 0.)
key UP
key UP
key UP
key UP
key HOME
wait_frames 12
menu_open Insert
wait_frames 12
menu_select "Table of Contents"
wait_frames 12

validate has_toc=true
validate toc_entries=3
validate text_contains_First Heading=true
validate text_contains_Second Heading=true
validate text_contains_Third Heading=true

# Leaders are measured to the text area's right edge, not the
# old 44-character column: an entry leader is far longer than
# the old maximum (44 - 15 = 29 dots for "First Heading").
# A 50-dot run exists post-fix and cannot exist pre-fix.
validate text_contains_..................................................=true

# Inserting again replaces the block: still one block, 3 entries.
menu_open Insert
wait_frames 12
menu_select "Table of Contents"
wait_frames 12
validate has_toc=true
validate toc_entries=3

# Add a heading, then Update: 4 entries, still one block.
# (key CTRL+END does not move the caret either — same harness
# quirk as CTRL+HOME — so walk DOWN to the last row, then END.)
key DOWN
key DOWN
key DOWN
key DOWN
key END
wait_frames 12
key ENTER
type "Fourth Heading"
key CTRL+ALT+2
wait_frames 12
menu_open Insert
wait_frames 12
menu_select "Update Table of Contents"
wait_frames 12
validate toc_entries=4
validate text_contains_Fourth Heading=true

# Right-click context menu Update keeps the block (no duplication).
right_click 50% 50%
wait_frames 18
click_text "Update Table of Contents"
wait_frames 12
validate toc_entries=4

screenshot toc
