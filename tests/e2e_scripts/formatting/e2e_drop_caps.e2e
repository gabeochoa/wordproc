# Test: Drop caps via the Format > Drop Cap dialog.
# The dialog (None / Dropped, Lines 2-4) applies to the caret
# paragraph as one undo step; the first glyph draws enlarged
# spanning N lines and the following lines indent past its width.

type "Hello world, this is a paragraph with a drop cap."
key ENTER
type "Second paragraph follows the first."
key ENTER
type "Third paragraph is beyond the drop cap span."
wait_frames 12

# Back to the first paragraph.
key UP
key UP
key HOME
wait_frames 12

menu_open Format
wait_frames 12
menu_select "Drop Cap"
wait_frames 12

validate dialog_open=DropCap
expect_text "Position:"
expect_text "Lines:"

screenshot dropcap_dialog

click_ui dropcap_dropped
wait_frames 12
click_ui dropcap_lines_plus
wait_frames 12
expect_text "Lines: 3"

click_ui dropcap_ok
wait_frames 12

validate dialog_open=false
validate drop_cap=true
validate drop_cap_lines=3

# The cap belongs to paragraph 1 only: moving the caret to
# paragraph 2 shows no drop cap there (Batch 11 fix round: the
# old renderer indented paragraphs 2 and 3 under paragraph 1's
# cap). The indent scoping itself is pinned by the unit test
# (drop_cap::coveringDropCapParagraph over wrapped lines), as
# the runner has no per-row pixel-x property.
key DOWN
key HOME
wait_frames 12
validate drop_cap=false
validate drop_cap_lines=0
key UP
wait_frames 12
validate drop_cap=true

screenshot dropcap

# One undo step restores the paragraph.
key CTRL+Z
wait_frames 12
validate drop_cap=false
validate drop_cap_lines=0

screenshot dropcap_off
