type "Text to copy"
wait_frames 6
key CTRL+A
wait_frames 6
click_ui btn_copy
wait_frames 6
key END
type " "
click_ui btn_paste
wait_frames 6
validate text=Text to copy Text to copy
screenshot toolbar_after_paste
key CTRL+A
wait_frames 6
click_ui btn_cut
wait_frames 6
validate text=
validate has_selection=false
click_ui btn_paste
wait_frames 6
validate text=Text to copy Text to copy
screenshot toolbar_after_cut_and_paste
