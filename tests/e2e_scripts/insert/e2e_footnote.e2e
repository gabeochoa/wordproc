# Test: Footnote insertion
# Validates footnotes can be inserted with auto-numbering

# Type some text
type "This statement needs a citation"
wait 2

# Insert footnote
menu_open Insert
wait 2
menu_select "Footnote"
wait 2

# Validate footnote was inserted
validate has_footnote=true
validate footnote_count=1

# Move to end and add another footnote
key CTRL+END
type " and another claim"
wait 2
menu_open Insert
wait 2
menu_select "Footnote"
wait 2

# Validate second footnote
validate footnote_count=2

screenshot e2e_footnote
