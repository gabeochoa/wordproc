# Test: Shape/drawing insertion
# Validates shapes can be inserted

# Type some text
type "Document with shapes:"
key ENTER
wait_frames 12

# Insert rectangle shape via Insert menu
menu_open Insert
wait_frames 12
menu_select "Shape: Rectangle"
wait_frames 12

# Draw the shape (click and drag). Coords are the 1280x720 layout at
# ui_scale 1.2: text area starts at y=153.6, so the drag stays below
# the ruler band (129..153).
drag 100 190 200 240
wait_frames 12

# Validate shape was inserted
validate has_drawing=true
validate drawing_count=1

# Insert another shape (circle)
menu_open Insert
wait_frames 12
menu_select "Shape: Circle"
wait_frames 12
drag 250 190 350 240
wait_frames 12

validate drawing_count=2

screenshot e2e_drawing
